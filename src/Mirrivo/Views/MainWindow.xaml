<Window x:Class="Mirrivo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Mirrivo.ViewModels"
        Title="MIRRIVO — Android Screen Control &amp; Wireless Mirroring"
        Height="730" Width="1020"
        MinHeight="630" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushCanvas}"
        Foreground="{StaticResource BrushInk}"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="/Assets/app_icon.png"
        BorderBrush="{StaticResource BrushHairline}"
        BorderThickness="1"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="{StaticResource BrushCanvas}">
        <Grid.RowDefinitions>
            <!-- 1. Apple macOS Frosted Top Header -->
            <RowDefinition Height="56" />
            <!-- 2. Main Content Body (Dynamic Tabs) -->
            <RowDefinition Height="*" />
            <!-- 3. Minimalist Footer -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ==============================================
             1. HEADER: APPLE UNIFIED NAV & TITLE BAR (LIGHT GLASS)
             ============================================== -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BrushHairline}"
                BorderThickness="0,0,0,1"
                Padding="18,0"
                MouseDown="TitleBar_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.03" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand & Status -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center: Segmented Navigation Pill -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Device Pill & Windows Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: MIRRIVO Brand & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App Icon & Logo -->
                    <Border Width="28" Height="28" CornerRadius="7" Background="#FFFFFF" BorderBrush="{StaticResource BrushHairline}" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="/Assets/app_icon.png" Stretch="Uniform" Margin="2" />
                    </Border>
                    <TextBlock Text="MIRRIVO"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushInk}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Border Background="#E8F8EE" BorderBrush="#D1F2DD" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSuccess}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="READY" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Apple Segmented Navigation Bar (CONCENTRIC ZERO-GAP DESIGN) -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E3E3E8"
                        BorderBrush="#D5D5DC"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tab 1: Mirror -->
                        <Button Style="{StaticResource AppleSegmentTab}"
                                Command="{Binding SetActiveTabCommand}"
                                CommandParameter="Mirror"
                                Margin="1,0"
                                Background="{Binding ActiveTab, Converter={StaticResource NavTabActiveBackground}, ConverterParameter=Mirror}"
                                Foreground="{Binding ActiveTab, Converter={StaticResource NavTabActiveForeground}, ConverterParameter=Mirror}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Mirror" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: Apps (Ghost & Dual Display) -->
                        <Button Style="{StaticResource AppleSegmentTab}"
                                Command="{Binding SetActiveTabCommand}"
                                CommandParameter="Apps"
                                Margin="1,0"
                                Background="{Binding ActiveTab, Converter={StaticResource NavTabActiveBackground}, ConverterParameter=Apps}"
                                Foreground="{Binding ActiveTab, Converter={StaticResource NavTabActiveForeground}, ConverterParameter=Apps}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Apps" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 3: Settings -->
                        <Button Style="{StaticResource AppleSegmentTab}"
                                Command="{Binding SetActiveTabCommand}"
                                CommandParameter="Settings"
                                Margin="1,0"
                                Background="{Binding ActiveTab, Converter={StaticResource NavTabActiveBackground}, ConverterParameter=Settings}"
                                Foreground="{Binding ActiveTab, Converter={StaticResource NavTabActiveForeground}, ConverterParameter=Settings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 3: Wireless -->
                        <Button Style="{StaticResource AppleSegmentTab}"
                                Command="{Binding SetActiveTabCommand}"
                                CommandParameter="Wireless"
                                Margin="1,0"
                                Background="{Binding ActiveTab, Converter={StaticResource NavTabActiveBackground}, ConverterParameter=Wireless}"
                                Foreground="{Binding ActiveTab, Converter={StaticResource NavTabActiveForeground}, ConverterParameter=Wireless}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Wireless" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 4: Console -->
                        <Button Style="{StaticResource AppleSegmentTab}"
                                Command="{Binding SetActiveTabCommand}"
                                CommandParameter="Console"
                                Margin="1,0"
                                Background="{Binding ActiveTab, Converter={StaticResource NavTabActiveBackground}, ConverterParameter=Console}"
                                Foreground="{Binding ActiveTab, Converter={StaticResource NavTabActiveForeground}, ConverterParameter=Console}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💻" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Console" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right: Device Live Capsule & In-App Update -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Connected Device Capsule -->
                    <Border Background="#FFFFFF"
                            BorderBrush="{StaticResource BrushHairline}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding SelectedDevice.StatusColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedDevice.Model}" FontFamily="{StaticResource FontSans}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushInk}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedDevice.BatteryDisplay}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushMute}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Refresh Devices Button -->
                    <Button Content="⟳"
                            ToolTip="Scan for devices"
                            Style="{StaticResource GeistIconButton}"
                            Width="30" Height="30"
                            Command="{Binding RefreshDevicesCommand}"
                            Margin="0,0,6,0" />

                    <!-- In-App OTA Update Button -->
                    <Button Command="{Binding CheckForUpdatesCommand}"
                            ToolTip="Check for Updates"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{Binding VersionBadgeBackground}"
                                        BorderBrush="{StaticResource BrushHairline}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,3">
                                    <TextBlock Text="{Binding VersionBadgeText}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding VersionBadgeForeground}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Standard Windows Window Controls (Minimize, Maximize, Close) -->
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource WindowControlBtn}" Width="36" Height="30" Click="MinimizeButton_Click" ToolTip="Minimize" Margin="0,0,2,0" />
                        <Button Content="□" Style="{StaticResource WindowControlBtn}" Width="36" Height="30" Click="MaximizeButton_Click" ToolTip="Maximize / Restore" Margin="0,0,2,0" />
                        <Button Content="✕" Style="{StaticResource WindowCloseBtn}" Width="36" Height="30" Click="CloseButton_Click" ToolTip="Close" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==============================================
             2. MAIN CONTENT BODY (TAB BASED)
             ============================================== -->
        <Grid Grid.Row="1" Margin="24,18">

            <!-- ==============================================
                 TAB 1: MIRROR (THE HERO INTERFACE)
                 ============================================== -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Mirror}">
                <Grid.RowDefinitions>
                    <!-- Optional Multi-Device Strip -->
                    <RowDefinition Height="Auto" />
                    <!-- Main Hero Stage -->
                    <RowDefinition Height="*" />
                    <!-- File Sharing Drop Zone -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Multi-Device Selection Bar (Visible only when 2+ devices are connected) -->
                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource BrushHairline}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8,4"
                        Margin="0,0,0,14"
                        Visibility="{Binding Devices.Count, Converter={StaticResource MultiCountToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="SELECT PHONE:"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushMute}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,12,0" />

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectTargetDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,6,0"
                                            Padding="12,5"
                                            Cursor="Hand"
                                            Style="{StaticResource AppleSegmentTab}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Model}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text=" · " Foreground="{StaticResource BrushMute}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ConnectionTypeDisplay}" Foreground="{StaticResource BrushMute}" FontSize="10" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Hero Section: When Device IS Connected -->
                <Border Grid.Row="1"
                        Background="{StaticResource BrushCanvasElevated}"
                        BorderBrush="{StaticResource BrushHairline}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="28"
                        Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.04" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Card Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Stage & Visual State -->
                            <RowDefinition Height="*" />
                            <!-- Hero CTA & Essential Action Capsules -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Hero Header: Device Specs & Live FPS/Battery -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Device Title & Badges -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="#F5F5F7" BorderBrush="{StaticResource BrushHairline}" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{Binding SelectedDevice.StatusColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedDevice.StatusText, FallbackValue=READY}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding SelectedDevice.StatusColor, Converter={StaticResource HexToBrush}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F5F5F7" BorderBrush="{StaticResource BrushHairline}" BorderThickness="1" CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="{Binding SelectedDevice.ConnectionTypeDisplay, FallbackValue='USB Cable'}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource BrushMute}" />
                                    </Border>
                                    <!-- Wireless Disconnect Pill -->
                                    <Button Style="{StaticResource AppleSegmentTab}"
                                            Content="🔌 Disconnect"
                                            Height="22"
                                            Padding="8,0"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Background="#FFF0F0"
                                            Foreground="#FF3B30"
                                            BorderBrush="#FFD6D6"
                                            BorderThickness="1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DisconnectWirelessCommand}"
                                            CommandParameter="{Binding SelectedDevice.Serial}"
                                            Visibility="{Binding SelectedDevice.IsWireless, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Disconnect Wi-Fi link" />
                                </StackPanel>

                                <TextBlock Text="{Binding SelectedDevice.Model, FallbackValue='Android Device'}"
                                           FontFamily="{StaticResource FontSans}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushInk}"
                                           Margin="0,0,0,3" />

                                <TextBlock Text="{Binding SelectedDevice.Serial, FallbackValue='192.168.1.8:5555'}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushMute}" />
                            </StackPanel>

                            <!-- Right: Single Stream FPS Counter + Battery -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <!-- Real-Time FPS Badge (Visible ONLY when mirroring is active) -->
                                <Border Background="#EBF5FF"
                                        BorderBrush="#B8DCFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,8"
                                        Margin="0,0,10,0"
                                        Visibility="{Binding IsMirroringActive, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="STREAM FPS" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushBlue}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding FpsDisplay}"
                                                   FontFamily="{StaticResource FontSans}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushBlue}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Battery Level -->
                                <Border Background="#F5F5F7"
                                        BorderBrush="{StaticResource BrushHairline}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="BATTERY" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushMute}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedDevice.BatteryDisplay, FallbackValue='88%'}"
                                                   FontFamily="{StaticResource FontSans}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushInk}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Hero Center: Visual Phone Stage (Frosted Pearl Container) -->
                        <Border Grid.Row="1"
                                Background="#F8F8FA"
                                BorderBrush="#EBEBEF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20"
                                Margin="0,0,0,20">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Idle Stage -->
                                <StackPanel HorizontalAlignment="Center" Visibility="{Binding IsMirroringActive, Converter={StaticResource InverseBoolToVis}}">
                                    <Border Width="58" Height="58" CornerRadius="16" Background="#FFFFFF" BorderBrush="{StaticResource BrushHairline}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12" ClipToBounds="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.06" />
                                        </Border.Effect>
                                        <Image Source="/Assets/app_icon.png" Stretch="Uniform" Margin="6" />
                                    </Border>
                                    <TextBlock Text="Ready for High-Speed Mirroring"
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushInk}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Click Start Mirroring to launch phone display on your PC with full mouse &amp; keyboard control."
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushBody}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushHairline}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedResolution, FallbackValue='1080p FHD'}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushBody}" />
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushHairline}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedFps, FallbackValue='60 FPS'}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushBody}" />
                                        </Border>
                                        <Border Background="#E8F8EE" BorderBrush="#D1F2DD" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                            <TextBlock Text="Zero Lag Input" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushSuccess}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Active Mirroring Stage -->
                                <StackPanel HorizontalAlignment="Center" Visibility="{Binding IsMirroringActive, Converter={StaticResource BoolToVis}}">
                                    <Border Width="58" Height="58" CornerRadius="16" Background="#EBF5FF" BorderBrush="#B8DCFF" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock Text="●" FontSize="28" Foreground="{StaticResource BrushBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Live Mirroring In Progress"
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushBlue}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Companion tool bar attached to phone window. Control directly with mouse &amp; keyboard."
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushBody}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushHairline}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedResolution}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushBody}" />
                                        </Border>
                                        <!-- Active Recording Indicator -->
                                        <Border Background="#FFEBEE" BorderBrush="{StaticResource BrushError}" BorderThickness="1" CornerRadius="8" Padding="10,4"
                                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource BrushError}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RecordingTimerText, StringFormat='REC {0}'}" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushError}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Hero Bottom: 1-Click Launch Button & Essential Action Capsules (NO DOUBLE ICONS!) -->
                        <StackPanel Grid.Row="2">
                            <!-- Primary Launch Pill -->
                            <Button Background="{Binding MirrorButtonBackground}"
                                    Foreground="{Binding MirrorButtonForeground}"
                                    Style="{StaticResource AppleActionPill}"
                                    Height="48"
                                    FontSize="15"
                                    Command="{Binding StartMirrorCommand}"
                                    Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsMirroringActive, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBlock Text="⏹" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsMirroringActive, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding MirrorButtonText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 4 Essential Action Capsules (Single Clean Icon Per Button!) -->
                            <UniformGrid Columns="4" Rows="1">
                                <!-- 1. When USB Cable Connected: Switch to Wi-Fi Mode -->
                                <Button Style="{StaticResource AppleQuickCardButton}"
                                        Command="{Binding SwitchModeCommand}"
                                        ToolTip="Convert USB connection to Wireless Wi-Fi. You can unplug the cable immediately after!"
                                        Height="42" Margin="0,0,6,0"
                                        Visibility="{Binding SelectedDevice.IsWireless, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Switch to Wi-Fi" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 1. When Wireless Wi-Fi Connected: Mount Phone Storage Drive -->
                                <Button Style="{StaticResource AppleQuickCardButton}"
                                        Command="{Binding TogglePhoneStorageCommand}"
                                        ToolTip="Mount phone storage as a Windows drive in File Explorer"
                                        Height="42" Margin="0,0,6,0"
                                        Visibility="{Binding SelectedDevice.IsWireless, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PhoneStorageButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 2. Sync Clipboard -->
                                <Button Style="{StaticResource AppleQuickCardButton}"
                                        Command="{Binding SyncClipboardCommand}"
                                        ToolTip="Sync clipboard text between PC and Phone"
                                        Height="42" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📋" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Sync Clipboard" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 3. Screenshot -->
                                <Button Style="{StaticResource AppleQuickCardButton}"
                                        Command="{Binding TakeScreenshotCommand}"
                                        ToolTip="Take high-resolution screenshot"
                                        Height="42" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📸" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Screenshot" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 4. Screen Recording -->
                                <Button Style="{StaticResource AppleQuickCardButton}"
                                        Command="{Binding ToggleRecordingCommand}"
                                        ToolTip="Record screen and audio to MP4"
                                        Background="{Binding RecordButtonBackground}"
                                        Foreground="{Binding RecordButtonForeground}"
                                        Height="42">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🔴" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RecordButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hero Section: When NO Device is Connected -->
                <Border Grid.Row="1"
                        Background="{StaticResource BrushCanvasElevated}"
                        BorderBrush="{StaticResource BrushHairline}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="36"
                        Visibility="{Binding SelectedDevice, Converter={StaticResource InverseNullToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.04" />
                    </Border.Effect>
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="68" Height="68" CornerRadius="18" Background="#F8F8FA" BorderBrush="{StaticResource BrushHairline}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,18" ClipToBounds="True">
                                <Image Source="/Assets/app_icon.png" Stretch="Uniform" Margin="8" />
                            </Border>
                            <TextBlock Text="No Android Device Connected"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushInk}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Connect your phone via USB cable or link wirelessly over Wi-Fi."
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushBody}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,24" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="⚡ Connect via USB Cable"
                                        Style="{StaticResource AppleActionPill}"
                                        Command="{Binding OpenUsbConnectCommand}"
                                        Margin="0,0,12,0" />

                                <Button Content="📡 Pair Wirelessly"
                                        Style="{StaticResource AppleQuickCardButton}"
                                        Padding="20,10"
                                        Height="48"
                                        Command="{Binding SetActiveTabCommand}"
                                        CommandParameter="Wireless" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- File Sharing Drop Zone -->
                <Border x:Name="DropZoneBorder"
                        Grid.Row="2"
                        Background="{StaticResource BrushCanvasElevated}"
                        BorderBrush="{StaticResource BrushHairline}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,12"
                        Margin="0,14,0,0"
                        AllowDrop="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.03" />
                    </Border.Effect>
                    <Grid>
                        <!-- Normal Idle State -->
                        <Grid Visibility="{Binding IsUploading, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="DropZoneIcon" Text="📥" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DropZoneText"
                                               Text="Drag &amp; drop files anywhere to share instantly with phone"
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Images &amp; Videos ➔ DCIM/Mirrivo Shared  •  APKs &amp; Documents ➔ Downloads"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="10"
                                               Foreground="{StaticResource BrushMute}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Live Uploading State -->
                        <Grid Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="13" Foreground="{StaticResource BrushBlue}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UploadFileName}"
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushInk}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="240"
                                               VerticalAlignment="Center" />
                                    <Border Background="#E8F8EE"
                                            BorderBrush="#D1F2DD"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UploadDestination}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushSuccess}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding UploadStatusDetails}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushBlue}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <Button Grid.Column="2"
                                        Content="✕ Cancel"
                                        Style="{StaticResource GeistButtonSquare}"
                                        Height="22"
                                        FontSize="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Command="{Binding CancelUploadCommand}" />
                            </Grid>

                            <ProgressBar Grid.Row="1"
                                         Height="4"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding UploadProgressPercent}"
                                         Foreground="{StaticResource BrushBlue}"
                                         Background="#E5E5EA"
                                         BorderThickness="0" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==============================================
                 TAB 2: APPS MANAGER & GHOST DUAL DISPLAY
                 ============================================== -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Apps}"
                  Margin="20,14,20,14">
                <Grid.RowDefinitions>
                    <!-- Row 0: Top Action Bar (Title, Search, Filters, Refresh) -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Dual Display Feature Banner -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 2: Apps Content (Grid or Empty/Loading State) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Top Action Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title & Live App Counters -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Applications"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushInk}"
                                       VerticalAlignment="Center" />
                            <Border Background="#E8E8ED"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource FontMono}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushInk}">
                                    <Run Text="{Binding FilteredApps.Count, Mode=OneWay}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding TotalAppsCount, Mode=OneWay}" />
                                    <Run Text="APPS" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Launch any app in an independent PC window or control directly on phone."
                                   FontFamily="{StaticResource FontSans}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushMute}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Right: View Mode Toggle, Filter Chips, Search, Refresh -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- View Mode Switcher (Grid vs List) -->
                        <Border Background="#E3E3E8"
                                BorderBrush="#D5D5DC"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="2"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⊞ Grid"
                                        Style="{StaticResource AppleSegmentTab}"
                                        Height="26"
                                        Padding="8,2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Command="{Binding SetAppsViewModeCommand}"
                                        CommandParameter="Grid"
                                        Background="{Binding AppsViewMode, Converter={StaticResource ViewModeActiveBackground}, ConverterParameter=Grid}"
                                        Foreground="{Binding AppsViewMode, Converter={StaticResource ViewModeActiveForeground}, ConverterParameter=Grid}" />
                                <Button Content="☰ List"
                                        Style="{StaticResource AppleSegmentTab}"
                                        Height="26"
                                        Padding="8,2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Command="{Binding SetAppsViewModeCommand}"
                                        CommandParameter="List"
                                        Background="{Binding AppsViewMode, Converter={StaticResource ViewModeActiveBackground}, ConverterParameter=List}"
                                        Foreground="{Binding AppsViewMode, Converter={StaticResource ViewModeActiveForeground}, ConverterParameter=List}" />
                            </StackPanel>
                        </Border>

                        <!-- Filter Segmented Bar -->
                        <Border Background="#E3E3E8"
                                BorderBrush="#D5D5DC"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="2"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="All"
                                        Style="{StaticResource AppleSegmentTab}"
                                        Height="26"
                                        Padding="10,2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Command="{Binding SetAppFilterCommand}"
                                        CommandParameter="All"
                                        Background="{Binding AppFilterMode, Converter={StaticResource FilterPillActiveBackground}, ConverterParameter=All}"
                                        Foreground="{Binding AppFilterMode, Converter={StaticResource FilterPillActiveForeground}, ConverterParameter=All}" />
                                <Button Content="User"
                                        Style="{StaticResource AppleSegmentTab}"
                                        Height="26"
                                        Padding="10,2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Command="{Binding SetAppFilterCommand}"
                                        CommandParameter="User"
                                        Background="{Binding AppFilterMode, Converter={StaticResource FilterPillActiveBackground}, ConverterParameter=User}"
                                        Foreground="{Binding AppFilterMode, Converter={StaticResource FilterPillActiveForeground}, ConverterParameter=User}" />
                                <Button Content="System"
                                        Style="{StaticResource AppleSegmentTab}"
                                        Height="26"
                                        Padding="10,2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Command="{Binding SetAppFilterCommand}"
                                        CommandParameter="System"
                                        Background="{Binding AppFilterMode, Converter={StaticResource FilterPillActiveBackground}, ConverterParameter=System}"
                                        Foreground="{Binding AppFilterMode, Converter={StaticResource FilterPillActiveForeground}, ConverterParameter=System}" />
                            </StackPanel>
                        </Border>

                        <!-- Search Input -->
                        <Border Background="#FFFFFF"
                                BorderBrush="{StaticResource BrushHairline}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Height="30"
                                Width="190"
                                Margin="0,0,8,0"
                                Padding="8,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{StaticResource BrushMute}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AppSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="{StaticResource FontSans}"
                                         FontSize="12"
                                         Foreground="{StaticResource BrushInk}"
                                         VerticalAlignment="Center">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                            <TextBlock Text="Search apps..."
                                                                       Foreground="#A1A1A6"
                                                                       FontSize="12"
                                                                       FontFamily="{StaticResource FontSans}"
                                                                       IsHitTestVisible="False"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- Refresh Apps Button -->
                        <Button Style="{StaticResource AppleSegmentTab}"
                                Command="{Binding LoadInstalledAppsCommand}"
                                IsEnabled="{Binding IsLoadingApps, Converter={StaticResource InverseBoolToVis}}"
                                Height="30"
                                Padding="12,3"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource BrushHairline}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳" FontSize="12" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Dual Display Engine Banner -->
                <Border Grid.Row="1"
                        Background="#F0F6FF"
                        BorderBrush="#D0E2FF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,9"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="✨" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Ghost Dual Display Multi-Instance Engine Active"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#0056B3" />
                            <TextBlock Text="Click 'PC' to run in an independent PC window without touching the phone screen. Click 'Phone' to open directly on phone."
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="11"
                                       Foreground="#3A5A80"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2"
                                Background="#0071E3"
                                CornerRadius="8"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="Android 10+" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 2: Content (Loading / Empty / Cards Grid) -->
                <Grid Grid.Row="2">
                    <!-- 1. Loading State -->
                    <Border Background="#FFFFFF"
                            BorderBrush="{StaticResource BrushHairline}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="30"
                            Visibility="{Binding IsLoadingApps, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="Scanning Installed Applications..."
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushInk}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Extracting launcher activities, verified names, and authentic high-res app icons"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushMute}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 2. No Device Empty State -->
                    <Border Background="#FFFFFF"
                            BorderBrush="{StaticResource BrushHairline}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="30"
                            Visibility="{Binding SelectedDevice, Converter={StaticResource InverseNullToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📱" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="No Phone Connected"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushInk}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Connect your Android device via USB cable or Wi-Fi to scan and launch apps."
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushMute}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,16" />
                            <Button Style="{StaticResource AppleActionPill}"
                                    Content="Go to Wireless Pairing"
                                    Height="36"
                                    FontSize="12"
                                    Padding="16,0"
                                    Command="{Binding SetActiveTabCommand}"
                                    CommandParameter="Wireless"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 3. VIEW MODE A: APPLE LAUNCHPAD GRID (DEFAULT) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsLoadingApps, Converter={StaticResource InverseBoolToVis}}">
                        <Grid>
                            <!-- Grid Mode Container -->
                            <ItemsControl ItemsSource="{Binding FilteredApps}"
                                          Visibility="{Binding AppsViewMode, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Grid}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Apple Launchpad App Tile -->
                                        <Border Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#FFFFFF"
                                                BorderBrush="{StaticResource BrushHairline}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Width="148"
                                                Height="186"
                                                Margin="6"
                                                Padding="8,10"
                                                Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04" />
                                            </Border.Effect>
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.OpenGhostDisplayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Border.ContextMenu>
                                                <ContextMenu Style="{StaticResource AppleContextMenu}">
                                                    <MenuItem Style="{StaticResource AppleMenuItem}"
                                                              Header="Launch in Ghost / Dual Display (PC)"
                                                              FontWeight="SemiBold"
                                                              Command="{Binding PlacementTarget.Tag.OpenGhostDisplayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="🖥️" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Style="{StaticResource AppleMenuItem}"
                                                              Header="Open on Physical Phone Screen"
                                                              Command="{Binding PlacementTarget.Tag.OpenOnPhoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="📱" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Style="{StaticResource AppleMenuSeparator}" />
                                                    <MenuItem Style="{StaticResource AppleMenuItem}"
                                                              Header="Force Stop App"
                                                              Command="{Binding PlacementTarget.Tag.ForceStopAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="🛑" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Style="{StaticResource AppleMenuItem}"
                                                              Header="Clear Data &amp; Cache"
                                                              Command="{Binding PlacementTarget.Tag.ClearAppDataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="🧹" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Style="{StaticResource AppleMenuItem}"
                                                              Header="Uninstall from Phone"
                                                              Foreground="{StaticResource BrushError}"
                                                              Command="{Binding PlacementTarget.Tag.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="🗑️" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Style="{StaticResource AppleMenuSeparator}" />
                                                    <MenuItem Style="{StaticResource AppleMenuItem}"
                                                              Header="App Information Details"
                                                              Command="{Binding PlacementTarget.Tag.ShowAppDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="ℹ️" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- Icon Row (60px) -->
                                                    <RowDefinition Height="62" />
                                                    <!-- App Name Row (38px) -->
                                                    <RowDefinition Height="38" />
                                                    <!-- Category Pill Row (18px) -->
                                                    <RowDefinition Height="18" />
                                                    <!-- Action Pill Row (Auto) -->
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Row 0: Real App Icon / Squircle -->
                                                <Grid Grid.Row="0" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Real APK/Play Store Icon -->
                                                    <Border CornerRadius="13"
                                                            ClipToBounds="True"
                                                            Background="Transparent"
                                                            Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}">
                                                        <Image Source="{Binding IconPath}"
                                                               Width="56" Height="56"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>

                                                    <!-- Fallback Squircle Icon -->
                                                    <Border Width="56" Height="56"
                                                            CornerRadius="13"
                                                            Background="{Binding IconColor, Converter={StaticResource HexToBrush}}"
                                                            Visibility="{Binding HasCustomIcon, Converter={StaticResource InverseBoolToVis}}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.10" />
                                                        </Border.Effect>
                                                        <Grid>
                                                            <TextBlock Text="{Binding IconGlyph}"
                                                                       FontSize="24"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Initials}"
                                                                       FontFamily="{StaticResource FontSans}"
                                                                       FontWeight="Bold"
                                                                       FontSize="15"
                                                                       Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IconGlyph, Converter={StaticResource StringEqualsToVis}, ConverterParameter='📱'}" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Border Glow Edge -->
                                                    <Border Width="56" Height="56"
                                                            CornerRadius="13"
                                                            BorderBrush="#1A000000"
                                                            BorderThickness="1"
                                                            IsHitTestVisible="False" />
                                                </Grid>

                                                <!-- Row 1: App Display Name -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding DisplayName}"
                                                           FontFamily="{StaticResource FontSans}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{StaticResource BrushInk}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="2,2,2,0" />

                                                <!-- Row 2: Category Pill -->
                                                <Border Grid.Row="2"
                                                        Background="#F2F2F7"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}"
                                                               FontFamily="{StaticResource FontSans}"
                                                               FontSize="8.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushMute}" />
                                                </Border>

                                                <!-- Row 3: Action Buttons (🖥️ PC Dual Display & 📱 Phone Screen) -->
                                                <Grid Grid.Row="3" VerticalAlignment="Bottom" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Primary: Dual Display on PC -->
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource AppleActionPill}"
                                                            ToolTip="Launch in independent Dual Display on PC (Zero Phone Disturbance)"
                                                            Command="{Binding DataContext.OpenGhostDisplayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Height="27"
                                                            Padding="0"
                                                            Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="🖥️" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="PC" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Secondary: Launch on Phone -->
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource AppleSegmentTab}"
                                                            ToolTip="Launch directly on phone screen"
                                                            Command="{Binding DataContext.OpenOnPhoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#F2F2F7"
                                                            Foreground="#1C1C1E"
                                                            BorderBrush="{StaticResource BrushHairline}"
                                                            BorderThickness="1"
                                                            Height="27"
                                                            Padding="0"
                                                            Margin="3,0,0,0">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="📱" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Phone" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- VIEW MODE B: DETAILED LIST VIEW -->
                            <ItemsControl ItemsSource="{Binding FilteredApps}"
                                          Visibility="{Binding AppsViewMode, Converter={StaticResource StringEqualsToVis}, ConverterParameter=List}"
                                          Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#FFFFFF"
                                                BorderBrush="{StaticResource BrushHairline}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Height="54"
                                                Margin="0,3"
                                                Padding="12,6"
                                                Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.02" />
                                            </Border.Effect>
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.OpenGhostDisplayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Icon -->
                                                    <ColumnDefinition Width="42" />
                                                    <!-- Name & Package -->
                                                    <ColumnDefinition Width="*" />
                                                    <!-- Category & Badges -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Actions -->
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <Grid Grid.Column="0" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border CornerRadius="9" ClipToBounds="True" Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}">
                                                        <Image Source="{Binding IconPath}" Width="36" Height="36" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <Border CornerRadius="9" Background="{Binding IconColor, Converter={StaticResource HexToBrush}}" Visibility="{Binding HasCustomIcon, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>

                                                <!-- Name & Package -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PackageName}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushMute}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Badges -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Border Background="#F2F2F7" CornerRadius="5" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource BrushMute}" />
                                                    </Border>
                                                    <Border Background="#F2F2F7" CornerRadius="5" Padding="6,2">
                                                        <TextBlock Text="{Binding AppTypeBadge}" FontFamily="{StaticResource FontMono}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding AppTypeColor, Converter={StaticResource HexToBrush}}" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource AppleActionPill}"
                                                            ToolTip="Launch in independent Dual Display on PC"
                                                            Command="{Binding DataContext.OpenGhostDisplayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Height="28"
                                                            Padding="12,0"
                                                            Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🖥️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="PC Display" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource AppleSegmentTab}"
                                                            ToolTip="Launch directly on phone screen"
                                                            Command="{Binding DataContext.OpenOnPhoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#F2F2F7"
                                                            Foreground="#1C1C1E"
                                                            BorderBrush="{StaticResource BrushHairline}"
                                                            BorderThickness="1"
                                                            Height="28"
                                                            Padding="12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📱" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Phone" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ==============================================
                 TAB 3: SETTINGS (macOS SYSTEM SETTINGS STYLE)
                 ============================================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Settings}">
                <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="0,8,0,24">
                    <!-- Section Title -->
                    <TextBlock Text="Preferences &amp; Stream Settings"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushInk}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Customize video quality, framerate, audio output, and mirroring behaviors."
                               FontFamily="{StaticResource FontSans}"
                               FontSize="13"
                               Foreground="{StaticResource BrushMute}"
                               Margin="0,0,0,20" />

                    <!-- Group 1: Video & Audio Quality -->
                    <Border Background="{StaticResource BrushCanvasElevated}"
                            BorderBrush="{StaticResource BrushHairline}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="22"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="VIDEO &amp; AUDIO STREAM QUALITY"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushMute}"
                                       Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Resolution" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Display resolution of the mirror window" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ResolutionOptions}"
                                          SelectedItem="{Binding SelectedResolution}"
                                          Style="{StaticResource GeistComboBox}" />
                            </Grid>

                            <Separator Background="{StaticResource BrushHairline}" Margin="0,4,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Frame Rate (FPS)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Maximum streaming target frame rate" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding FpsOptions}"
                                          SelectedItem="{Binding SelectedFps}"
                                          Style="{StaticResource GeistComboBox}" />
                            </Grid>

                            <Separator Background="{StaticResource BrushHairline}" Margin="0,4,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Video Bitrate" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Encoding bit rate for sharpness and bandwidth" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding BitrateOptions}"
                                          SelectedItem="{Binding SelectedBitrate}"
                                          Style="{StaticResource GeistComboBox}" />
                            </Grid>

                            <Separator Background="{StaticResource BrushHairline}" Margin="0,4,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Latency Preset" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Buffer size trade-off between smoothness &amp; latency" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LatencyOptions}"
                                          SelectedItem="{Binding SelectedLatency}"
                                          Style="{StaticResource GeistComboBox}" />
                            </Grid>

                            <Separator Background="{StaticResource BrushHairline}" Margin="0,4,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Audio Routing" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Stream phone audio to PC speakers or keep on phone" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AudioRoutingOptions}"
                                          SelectedItem="{Binding SelectedAudioRouting}"
                                          Style="{StaticResource GeistComboBox}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Group 2: Behavioral & Optimization Toggles -->
                    <Border Background="{StaticResource BrushCanvasElevated}"
                            BorderBrush="{StaticResource BrushHairline}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="22">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="BEHAVIORS &amp; PERFORMANCE"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushMute}"
                                       Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Keep Mirror Window Always on Top" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Keep the phone window floating above all other desktop applications" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource GeistToggleSwitch}" />
                            </Grid>

                            <Separator Background="{StaticResource BrushHairline}" Margin="0,4,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Stay Awake" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Prevent phone display and lockscreen from sleeping while connected" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding StayAwake}" Style="{StaticResource GeistToggleSwitch}" />
                            </Grid>

                            <Separator Background="{StaticResource BrushHairline}" Margin="0,4,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Turn Phone Screen Off While Mirroring" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Saves phone battery and prevents physical overheating during long sessions" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding TurnScreenOff}" Style="{StaticResource GeistToggleSwitch}" />
                            </Grid>

                            <Separator Background="{StaticResource BrushHairline}" Margin="0,4,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Automatic Clipboard Sync (PC ⇄ Phone)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Seamlessly copy text on PC and paste directly on phone, and vice-versa" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding ClipboardAutoSync}" Style="{StaticResource GeistToggleSwitch}" />
                            </Grid>

                            <Separator Background="{StaticResource BrushHairline}" Margin="0,4,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ultra-Low Latency Wi-Fi Mode" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                    <TextBlock Text="Bypasses buffering queues for instant mouse responsiveness over Wi-Fi" FontSize="11" Foreground="{StaticResource BrushMute}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding Config.LowLatencyWifiMode}" Style="{StaticResource GeistToggleSwitch}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==============================================
                 TAB 3: WIRELESS (EFFORTLESS WI-FI PAIRING)
                 ============================================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Wireless}">
                <StackPanel MaxWidth="620" HorizontalAlignment="Center" Margin="0,12,0,24">
                    <TextBlock Text="Wireless ADB Link"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushInk}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Connect your Android device wirelessly over your local Wi-Fi network without cables."
                               FontFamily="{StaticResource FontSans}"
                               FontSize="13"
                               Foreground="{StaticResource BrushMute}"
                               Margin="0,0,0,20" />

                    <!-- Active Wireless Connection Card (Visible when Wi-Fi device is connected) -->
                    <Border Background="#F0F8FF"
                            BorderBrush="#D0E2FF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasWirelessDevice, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#0071E3" Opacity="0.08" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Active Wireless Link Connected" FontWeight="Bold" FontSize="13" Foreground="#0056B3" />
                                </StackPanel>
                                <TextBlock Text="{Binding ConnectedWirelessDevice.Model, FallbackValue='Wi-Fi Android Phone'}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrushInk}" Margin="0,4,0,2" />
                                <TextBlock Text="{Binding ConnectedWirelessDevice.Serial}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushMute}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="🔌 Disconnect Wi-Fi"
                                    Style="{StaticResource AppleCompactActionPill}"
                                    Background="#FF3B30"
                                    VerticalAlignment="Center"
                                    Height="32"
                                    Padding="16,0"
                                    FontSize="12"
                                    Command="{Binding DisconnectWirelessCommand}"
                                    CommandParameter="{Binding ConnectedWirelessDevice.Serial}" />
                        </Grid>
                    </Border>

                    <!-- Quick Switch USB to Wireless (If USB device is plugged in) -->
                    <Border Background="{StaticResource BrushCanvasElevated}"
                            BorderBrush="{StaticResource BrushHairline}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Have a phone connected via USB right now?" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushInk}" />
                                <TextBlock Text="Convert it to wireless with 1 click. You can unplug the cable immediately after!" FontSize="11" Foreground="{StaticResource BrushMute}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AppleCompactActionPill}"
                                    Height="32"
                                    Padding="16,0"
                                    FontSize="12"
                                    Command="{Binding SwitchModeCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Convert to Wi-Fi" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Direct Connect Card -->
                    <Border Background="{StaticResource BrushCanvasElevated}"
                            BorderBrush="{StaticResource BrushHairline}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.04" />
                        </Border.Effect>
                        <StackPanel>
                            <!-- Mode Switcher Pill -->
                            <Border Background="#E8E8ED"
                                    BorderBrush="#D5D5DC"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="2"
                                    Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Direct IP (Port 5555)"
                                            Style="{StaticResource AppleSegmentTab}"
                                            Command="{Binding SetWirelessModeCommand}"
                                            CommandParameter="Direct" />
                                    <Button Grid.Column="1"
                                            Content="Pair with Code (Android 11+)"
                                            Style="{StaticResource AppleSegmentTab}"
                                            Command="{Binding SetWirelessModeCommand}"
                                            CommandParameter="Pair" />
                                </Grid>
                            </Border>

                            <!-- IP Address Input -->
                            <TextBlock Text="PHONE IP ADDRESS" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushMute}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource GeistTextBox}"
                                     Text="{Binding WirelessIp, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14" />

                            <!-- Port Input -->
                            <TextBlock Text="PORT" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushMute}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource GeistTextBox}"
                                     Text="{Binding WirelessPort, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14" />

                            <!-- Pairing Code (Visible only when pairing mode is active) -->
                            <StackPanel Visibility="{Binding IsWirelessPairingMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                <TextBlock Text="6-DIGIT PAIRING CODE" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushMute}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource GeistTextBox}"
                                         Text="{Binding WirelessPairCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Connect & Disconnect Buttons Row -->
                            <Grid Margin="0,6,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding IsConnectingWireless, Converter={x:Null}, FallbackValue='Connect Wirelessly'}"
                                        Style="{StaticResource AppleActionPill}"
                                        Command="{Binding ConnectWirelessDirectCommand}"
                                        IsEnabled="{Binding IsConnectingWireless, Converter={StaticResource InverseBoolToVis}}"
                                        Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="🔌 Disconnect"
                                        Style="{StaticResource AppleSegmentTab}"
                                        Height="48"
                                        Padding="16,0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Background="#FFF0F0"
                                        Foreground="#FF3B30"
                                        BorderBrush="#FFD6D6"
                                        BorderThickness="1"
                                        Command="{Binding DisconnectWirelessCommand}"
                                        ToolTip="Disconnect active wireless session" />
                            </Grid>

                            <!-- Status Message -->
                            <TextBlock Text="{Binding WirelessStatusMessage}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushBlue}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,14" />

                            <!-- Instructions -->
                            <Border Background="#F5F5F7" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="HOW TO CONNECT:" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushMute}" Margin="0,0,0,4" />
                                    <TextBlock Text="1. Ensure PC and Phone are on the same Wi-Fi." FontSize="11" Foreground="{StaticResource BrushBody}" Margin="0,2" />
                                    <TextBlock Text="2. On Phone: Settings ➔ Developer Options ➔ Wireless Debugging (ON)." FontSize="11" Foreground="{StaticResource BrushBody}" Margin="0,2" />
                                    <TextBlock Text="3. Enter the IP &amp; Port shown on your phone and tap Connect." FontSize="11" Foreground="{StaticResource BrushBody}" Margin="0,2" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==============================================
                 TAB 4: CONSOLE (DIAGNOSTICS & ADB LOGS)
                 ============================================== -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Console}">
                <Border Background="{StaticResource BrushCanvasElevated}"
                        BorderBrush="{StaticResource BrushHairline}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DIAGNOSTIC TERMINAL &amp; ADB LOGS"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushMute}" />
                            </StackPanel>

                            <Button Content="Clear Logs"
                                    Style="{StaticResource GeistButtonSquare}"
                                    Height="28"
                                    FontSize="11"
                                    Padding="12,2"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearLogsCommand}" />
                        </Grid>

                        <!-- Logs List -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Logs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="{Binding TimeFormatted}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushMute}"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Message}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="11"
                                                   Foreground="{Binding LevelColor}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==============================================
             3. FOOTER STATUS BAR
             ============================================== -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BrushHairline}"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TARGET // "
                               FontFamily="{StaticResource FontMono}"
                               FontSize="10"
                               Foreground="{StaticResource BrushMute}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DetailedDevicesSummary}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="10"
                               Foreground="{StaticResource BrushBody}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="MIRRIVO ENGINE ✦ SCRCPY 5.0 &amp; ADB"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="10"
                           Foreground="{StaticResource BrushMute}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
