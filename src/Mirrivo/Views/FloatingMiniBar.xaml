<Window x:Class="Mirrivo.Views.FloatingMiniBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIRRIVO Quick Bar"
        Width="46"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        ToolTipService.InitialShowDelay="50"
        ToolTipService.ShowDuration="6000"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/GeistTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Modern Dark ToolTip Style -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#171717" />
                <Setter Property="Foreground" Value="#EDEDED" />
                <Setter Property="BorderBrush" Value="#383838" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Floating Vertical Action Button Style -->
            <Style x:Key="FloatingVerticalBtn" TargetType="Button">
                <Setter Property="Background" Value="#161616" />
                <Setter Property="Foreground" Value="#D4D4D4" />
                <Setter Property="BorderBrush" Value="#292929" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#242424" />
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#444444" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#0F0F0F" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Vertical Floating Pill Body -->
    <Border Background="#121212"
            BorderBrush="{StaticResource BrushHairlineLight}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="4,8"
            Margin="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
        </Border.Effect>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

            <!-- 1. Drag / Docking Pin Header -->
            <Grid Margin="0,0,0,4">
                <Button x:Name="BtnPin"
                        Style="{StaticResource FloatingVerticalBtn}"
                        Width="26" Height="22"
                        Margin="0"
                        ToolTip="Attached to Phone (Click to undock / re-dock)"
                        Click="PinButton_Click">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="16" Height="16">
                            <!-- Pin Icon (Glowing blue when locked/docked) -->
                            <Path x:Name="PathPin"
                                  Data="M 8 2 L 12 6 L 10 8 L 13 11 L 11 13 L 8 10 L 6 12 L 2 8 Z M 5 11 L 2 14"
                                  Stroke="#0070F3" Fill="#0070F3"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- 2. Back -->
            <Button Style="{StaticResource FloatingVerticalBtn}" ToolTip="Back (Return to previous screen)" Command="{Binding SendKeyCommand}" CommandParameter="Back">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 10 3 L 5 8 L 10 13 M 5 8 H 15"
                              Stroke="#D4D4D4" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- 3. Home -->
            <Button Style="{StaticResource FloatingVerticalBtn}" ToolTip="Home (Phone launcher)" Command="{Binding SendKeyCommand}" CommandParameter="Home">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 2 7.5 L 8 2.5 L 14 7.5 V 13.5 C 14 14 13.5 14.5 13 14.5 H 3 C 2.5 14.5 2 14 2 13.5 Z M 6 14.5 V 9.5 H 10 V 14.5"
                              Stroke="#D4D4D4" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- 4. Recent Apps -->
            <Button Style="{StaticResource FloatingVerticalBtn}" ToolTip="Recent Apps (App switcher)" Command="{Binding SendKeyCommand}" CommandParameter="AppSwitch">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 3 3 H 10 V 10 H 3 Z M 6 6 H 13 V 13 H 6 Z"
                              Stroke="#D4D4D4" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- 5. Power -->
            <Button Style="{StaticResource FloatingVerticalBtn}" ToolTip="Power (Lock / Wake phone)" Command="{Binding SendKeyCommand}" CommandParameter="Power">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 8 2 V 7 M 4.2 4.2 A 5.5 5.5 0 1 0 11.8 4.2"
                              Stroke="#D4D4D4" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#262626" Margin="4,4" />

            <!-- 6. Screenshot -->
            <Button Style="{StaticResource FloatingVerticalBtn}" ToolTip="Take Screenshot (Save to Pictures)" Command="{Binding TakeScreenshotCommand}">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 2 5.5 C 2 4.7 2.7 4 3.5 4 H 5 L 6.2 2.5 H 9.8 L 11 4 H 12.5 C 13.3 4 14 4.7 14 5.5 V 12.5 C 14 13.3 13.3 14 12.5 14 H 3.5 C 2.7 14 2 13.3 2 12.5 Z M 8 11.5 A 2.5 2.5 0 1 0 8 6.5 A 2.5 2.5 0 1 0 8 11.5"
                              Stroke="#D4D4D4" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- 7. Screen Recording (Dynamic Record / Stop) -->
            <Button ToolTip="Record Screen &amp; Audio (MP4)"
                    Command="{Binding ToggleRecordingCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FloatingVerticalBtn}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Background" Value="#FF3B30" />
                                <Setter Property="BorderBrush" Value="#FF453A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <!-- Idle Record Icon (Clean Red Dot) -->
                    <Viewbox Width="14" Height="14" Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVis}}">
                        <Canvas Width="16" Height="16">
                            <Ellipse Width="10" Height="10" Canvas.Left="3" Canvas.Top="3" Fill="#EF4444" />
                            <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" Stroke="#EF4444" StrokeThickness="1.2" Opacity="0.5" />
                        </Canvas>
                    </Viewbox>

                    <!-- Active Recording Square (White Stop Symbol) -->
                    <Rectangle Width="9" Height="9" Fill="#FFFFFF" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>

            <!-- 8. Screen Off Toggle -->
            <Button Style="{StaticResource FloatingVerticalBtn}" ToolTip="Turn Phone Display Off / On (Save battery)" Command="{Binding TogglePhoneDisplayCommand}">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 13 10 A 5.5 5.5 0 1 1 6 3 A 4.5 4.5 0 0 0 13 10 Z"
                              Stroke="#D4D4D4" StrokeThickness="1.3" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- 9. Clipboard Sync -->
            <Button Style="{StaticResource FloatingVerticalBtn}" ToolTip="Sync Clipboard (PC ⇄ Phone)" Command="{Binding SyncClipboardCommand}">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 6 2 H 10 V 4 H 6 Z M 4 4 H 5 V 3 C 5 2 6 2 6 2 H 10 C 10 2 11 2 11 3 V 4 H 12 C 12.8 4 13.5 4.7 13.5 5.5 V 13.5 C 13.5 14.3 12.8 15 12 15 H 4 C 3.2 15 2.5 14.3 2.5 13.5 V 5.5 C 2.5 4.7 3.2 4 4 4 Z M 5 8 H 11 M 5 11 H 9"
                              Stroke="#D4D4D4" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- 10. Phone File Explorer -->
            <Button Style="{StaticResource FloatingVerticalBtn}"
                    ToolTip="Open Phone Storage in Windows File Explorer"
                    Command="{Binding TogglePhoneStorageCommand}">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 2 4.5 C 2 3.7 2.7 3 3.5 3 H 6.5 L 8 5 H 12.5 C 13.3 5 14 5.7 14 6.5 V 12.5 C 14 13.3 13.3 14 12.5 14 H 3.5 C 2.7 14 2 13.3 2 12.5 Z"
                              Stroke="#D4D4D4" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#262626" Margin="4,4" />

            <!-- 10. Volume Up -->
            <Button Style="{StaticResource FloatingVerticalBtn}" ToolTip="Volume Up" Command="{Binding SendKeyCommand}" CommandParameter="VolUp">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 2 5.5 H 4.5 L 8 2.5 V 13.5 L 4.5 10.5 H 2 Z M 11 8 H 15 M 13 6 V 10"
                              Stroke="#D4D4D4" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- 11. Volume Down -->
            <Button Style="{StaticResource FloatingVerticalBtn}" ToolTip="Volume Down" Command="{Binding SendKeyCommand}" CommandParameter="VolDown">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 2 5.5 H 4.5 L 8 2.5 V 13.5 L 4.5 10.5 H 2 Z M 11 8 H 15"
                              Stroke="#D4D4D4" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#262626" Margin="4,4" />

            <!-- 12. Close -->
            <Button Style="{StaticResource FloatingVerticalBtn}"
                    Height="24" Width="26"
                    ToolTip="Hide Bar"
                    Click="Close_Click">
                <Viewbox Width="10" Height="10">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                              Stroke="#888888" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>
    </Border>
</Window>
