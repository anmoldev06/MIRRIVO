<Window x:Class="Mirrivo.Views.FloatingMiniBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIRRIVO Quick Bar"
        Height="46" Width="510"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ToolTipService.InitialShowDelay="50"
        ToolTipService.ShowDuration="6000"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/GeistTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Modern Dark ToolTip Style -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#171717" />
                <Setter Property="Foreground" Value="#EDEDED" />
                <Setter Property="BorderBrush" Value="#383838" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Floating Action Button Style -->
            <Style x:Key="FloatingBtn" TargetType="Button">
                <Setter Property="Background" Value="#161616" />
                <Setter Property="Foreground" Value="#D4D4D4" />
                <Setter Property="BorderBrush" Value="#292929" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#242424" />
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#444444" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#0F0F0F" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Floating Pill Body -->
    <Border Background="#121212"
            BorderBrush="{StaticResource BrushHairlineLight}"
            BorderThickness="1"
            CornerRadius="23"
            Padding="8,4"
            Margin="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Grip Handle -->
                <ColumnDefinition Width="*" />    <!-- Action Buttons -->
                <ColumnDefinition Width="Auto" /> <!-- Close -->
            </Grid.ColumnDefinitions>

            <!-- 1. Drag Grip -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0" Cursor="SizeAll" ToolTip="Drag anywhere on screen">
                <TextBlock Text="⋮⋮" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{StaticResource BrushMute}" VerticalAlignment="Center" />
                <Border Width="6" Height="6" CornerRadius="3" Background="#0070F3" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 2. Remote Buttons & Actions (Crisp Vector Icons) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 1. Back -->
                <Button Style="{StaticResource FloatingBtn}" ToolTip="Back (Return to previous screen)" Command="{Binding SendKeyCommand}" CommandParameter="Back">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 10 3 L 5 8 L 10 13 M 5 8 H 15"
                                  Stroke="#D4D4D4" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 2. Home -->
                <Button Style="{StaticResource FloatingBtn}" ToolTip="Home (Phone launcher)" Command="{Binding SendKeyCommand}" CommandParameter="Home">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 2 7.5 L 8 2.5 L 14 7.5 V 13.5 C 14 14 13.5 14.5 13 14.5 H 3 C 2.5 14.5 2 14 2 13.5 Z M 6 14.5 V 9.5 H 10 V 14.5"
                                  Stroke="#D4D4D4" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 3. Recent Apps -->
                <Button Style="{StaticResource FloatingBtn}" ToolTip="Recent Apps (App switcher)" Command="{Binding SendKeyCommand}" CommandParameter="AppSwitch">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 3 3 H 10 V 10 H 3 Z M 6 6 H 13 V 13 H 6 Z"
                                  Stroke="#D4D4D4" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 4. Power -->
                <Button Style="{StaticResource FloatingBtn}" ToolTip="Power (Lock / Wake phone)" Command="{Binding SendKeyCommand}" CommandParameter="Power">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 8 2 V 7 M 4.2 4.2 A 5.5 5.5 0 1 0 11.8 4.2"
                                  Stroke="#D4D4D4" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Divider -->
                <Rectangle Width="1" Height="18" Fill="#262626" Margin="4,0" />

                <!-- 5. Screenshot -->
                <Button Style="{StaticResource FloatingBtn}" ToolTip="Take Screenshot (Save to Pictures)" Command="{Binding TakeScreenshotCommand}">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 2 5.5 C 2 4.7 2.7 4 3.5 4 H 5 L 6.2 2.5 H 9.8 L 11 4 H 12.5 C 13.3 4 14 4.7 14 5.5 V 12.5 C 14 13.3 13.3 14 12.5 14 H 3.5 C 2.7 14 2 13.3 2 12.5 Z M 8 11.5 A 2.5 2.5 0 1 0 8 6.5 A 2.5 2.5 0 1 0 8 11.5"
                                  Stroke="#D4D4D4" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 6. Screen Recording (Dynamic Record / Stop) -->
                <Button Style="{StaticResource FloatingBtn}"
                        ToolTip="Record Screen &amp; Audio (MP4)"
                        Command="{Binding ToggleRecordingCommand}"
                        Background="{Binding RecordButtonBackground}">
                    <Grid>
                        <!-- Idle Record Icon -->
                        <Viewbox Width="14" Height="14" Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVis}}">
                            <Canvas Width="16" Height="16">
                                <Ellipse Width="10" Height="10" Canvas.Left="3" Canvas.Top="3" Fill="#EF4444" />
                                <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" Stroke="#EF4444" StrokeThickness="1.2" Opacity="0.5" />
                            </Canvas>
                        </Viewbox>

                        <!-- Active Recording Square + Timer -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                            <Rectangle Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,3,0" />
                            <TextBlock Text="{Binding RecordingTimerText}" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- 7. Screen Off Toggle -->
                <Button Style="{StaticResource FloatingBtn}" ToolTip="Turn Phone Display Off / On (Save battery)" Command="{Binding TogglePhoneDisplayCommand}">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 13 10 A 5.5 5.5 0 1 1 6 3 A 4.5 4.5 0 0 0 13 10 Z"
                                  Stroke="#D4D4D4" StrokeThickness="1.3" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 8. Clipboard Sync -->
                <Button Style="{StaticResource FloatingBtn}" ToolTip="Sync Clipboard (PC ⇄ Phone)" Command="{Binding SyncClipboardCommand}">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 6 2 H 10 V 4 H 6 Z M 4 4 H 5 V 3 C 5 2 6 2 6 2 H 10 C 10 2 11 2 11 3 V 4 H 12 C 12.8 4 13.5 4.7 13.5 5.5 V 13.5 C 13.5 14.3 12.8 15 12 15 H 4 C 3.2 15 2.5 14.3 2.5 13.5 V 5.5 C 2.5 4.7 3.2 4 4 4 Z M 5 8 H 11 M 5 11 H 9"
                                  Stroke="#D4D4D4" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 9. Volume Up -->
                <Button Style="{StaticResource FloatingBtn}" ToolTip="Volume Up" Command="{Binding SendKeyCommand}" CommandParameter="VolUp">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 2 5.5 H 4.5 L 8 2.5 V 13.5 L 4.5 10.5 H 2 Z M 11 8 H 15 M 13 6 V 10"
                                  Stroke="#D4D4D4" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 10. Volume Down -->
                <Button Style="{StaticResource FloatingBtn}" ToolTip="Volume Down" Command="{Binding SendKeyCommand}" CommandParameter="VolDown">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 2 5.5 H 4.5 L 8 2.5 V 13.5 L 4.5 10.5 H 2 Z M 11 8 H 15"
                                  Stroke="#D4D4D4" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

            <!-- 3. Close Button -->
            <Button Grid.Column="2"
                    Style="{StaticResource FloatingBtn}"
                    Width="28" Height="28"
                    Margin="4,0,2,0"
                    ToolTip="Hide Floating Bar"
                    Click="Close_Click">
                <Viewbox Width="11" Height="11">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                              Stroke="#888888" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</Window>
