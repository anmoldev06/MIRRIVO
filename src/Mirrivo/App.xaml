<Application x:Class="Mirrivo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Mirrivo.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/GeistTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />
            <converters:CountToVisibilityConverter x:Key="CountToVis" MinCount="1" />
            <converters:CountToVisibilityConverter x:Key="MultiCountToVis" MinCount="2" />
            <converters:HexToBrushConverter x:Key="HexToBrush" />
            <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVis" />
            <converters:StringEqualsToVisibilityConverter x:Key="StringNotEqualsToVis" Invert="True" />
            <converters:StringEqualsToBrushConverter x:Key="NavTabActiveBackground" ActiveBrush="#FFFFFF" InactiveBrush="Transparent" />
            <converters:StringEqualsToBrushConverter x:Key="NavTabActiveForeground" ActiveBrush="#1D1D1F" InactiveBrush="#6E6E73" />
            <converters:StringEqualsToBrushConverter x:Key="FilterPillActiveBackground" ActiveBrush="#0071E3" InactiveBrush="#E8E8ED" />
            <converters:StringEqualsToBrushConverter x:Key="FilterPillActiveForeground" ActiveBrush="#FFFFFF" InactiveBrush="#1D1D1F" />
            <converters:StringEqualsToBrushConverter x:Key="ViewModeActiveBackground" ActiveBrush="#FFFFFF" InactiveBrush="Transparent" />
            <converters:StringEqualsToBrushConverter x:Key="ViewModeActiveForeground" ActiveBrush="#1D1D1F" InactiveBrush="#6E6E73" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
