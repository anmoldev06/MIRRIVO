<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>MIRRIVO</ApplicationTitle>
    <Product>MIRRIVO</Product>
    <Description>Modern Android Screen Control &amp; Wireless Mirroring</Description>
    <Version>1.0.3</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NWebDav.Server.HttpListener" Version="0.1.36" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.*" />
    <EmbeddedResource Include="Engine.zip" Condition="Exists('Engine.zip')" />
    <None Update="Engine\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
