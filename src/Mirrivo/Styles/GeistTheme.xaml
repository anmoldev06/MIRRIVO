<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==============================================
         VERCEL GEIST DESIGN TOKENS (from DESIGN-vercel.md)
         ============================================== -->
    <Color x:Key="ColorCanvas">#0A0A0A</Color>
    <Color x:Key="ColorCanvasElevated">#121212</Color>
    <Color x:Key="ColorCanvasSoft">#181818</Color>
    <Color x:Key="ColorHairline">#262626</Color>
    <Color x:Key="ColorHairlineLight">#333333</Color>
    <Color x:Key="ColorInk">#FFFFFF</Color>
    <Color x:Key="ColorInkDark">#171717</Color>
    <Color x:Key="ColorBody">#A1A1A1</Color>
    <Color x:Key="ColorMute">#707070</Color>
    <Color x:Key="ColorBlue">#0070F3</Color>
    <Color x:Key="ColorCyan">#50E3C2</Color>
    <Color x:Key="ColorViolet">#7928CA</Color>
    <Color x:Key="ColorPink">#EB367F</Color>
    <Color x:Key="ColorAmber">#F5A623</Color>
    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorError">#EE0000</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BrushCanvas" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="BrushCanvasElevated" Color="{StaticResource ColorCanvasElevated}" />
    <SolidColorBrush x:Key="BrushCanvasSoft" Color="{StaticResource ColorCanvasSoft}" />
    <SolidColorBrush x:Key="BrushHairline" Color="{StaticResource ColorHairline}" />
    <SolidColorBrush x:Key="BrushHairlineLight" Color="{StaticResource ColorHairlineLight}" />
    <SolidColorBrush x:Key="BrushInk" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="BrushInkDark" Color="{StaticResource ColorInkDark}" />
    <SolidColorBrush x:Key="BrushInkSecondary" Color="#B0B0B0" />
    <SolidColorBrush x:Key="BrushBody" Color="{StaticResource ColorBody}" />
    <SolidColorBrush x:Key="BrushMute" Color="{StaticResource ColorMute}" />
    <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource ColorBlue}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />

    <!-- Vercel Signature Mesh Gradient -->
    <LinearGradientBrush x:Key="BrushVercelGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0070F3" Offset="0.0" />
        <GradientStop Color="#50E3C2" Offset="0.25" />
        <GradientStop Color="#7928CA" Offset="0.55" />
        <GradientStop Color="#EB367F" Offset="0.80" />
        <GradientStop Color="#F5A623" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Fonts -->
    <FontFamily x:Key="FontSans">Segoe UI, -apple-system, BlinkMacSystemFont, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

    <!-- ==============================================
         SCROLLBAR STYLE (Minimalist Geist Dark)
         ============================================== -->
    <Style x:Key="GeistScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="thumbBorder"
                            CornerRadius="3"
                            Background="#2A2A2A"
                            Margin="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="thumbBorder" Property="Background" Value="#444444" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource BrushBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="6" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent" SnapsToDevicePixels="true">
                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource GeistScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent" SnapsToDevicePixels="true">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource GeistScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==============================================
         BUTTON STYLES
         ============================================== -->
    <Style x:Key="GeistButtonPillPrimary" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="19"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E5E5E5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#CCCCCC" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#222222" />
                            <Setter Property="Foreground" Value="#666666" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeistButtonPillSecondary" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#EDEDED" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushHairlineLight}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="17"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1F1F1F" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#444444" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2A2A2A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeistButtonSquare" TargetType="Button">
        <Setter Property="Background" Value="#171717" />
        <Setter Property="Foreground" Value="#EDEDED" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#242424" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#383838" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#101010" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GeistIconButton" TargetType="Button">
        <Setter Property="Background" Value="#141414" />
        <Setter Property="Foreground" Value="#D4D4D4" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#222222" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#444444" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0F0F0F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================
         TEXTBOX STYLE (Fixed vertical clipping bug)
         ============================================== -->
    <Style x:Key="GeistTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#121212" />
        <Setter Property="Foreground" Value="#EDEDED" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushBlue}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrushBlue}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Height" Value="38" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#444444" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBlue}" />
                            <Setter TargetName="border" Property="Background" Value="#161616" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================
         CUSTOM COMBOBOX & COMBOBOXITEM STYLES
         (Completely fixes white popup bug in Image 1)
         ============================================== -->
    
    <!-- ComboBoxItem Style -->
    <Style x:Key="GeistComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="#D4D4D4" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="itemBorder"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            Margin="2,1">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="#222222" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="#0070F3" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox Toggle Button Template -->
    <ControlTemplate x:Key="GeistComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Border x:Name="templateRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="true">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <!-- Chevron Down Icon -->
                <Path x:Name="arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0"
                      Stroke="#8F8F8F"
                      StrokeThickness="1.5"
                      SnapsToDevicePixels="false" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#444444" />
                <Setter TargetName="templateRoot" Property="Background" Value="#1A1A1A" />
                <Setter TargetName="arrow" Property="Stroke" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{StaticResource BrushBlue}" />
                <Setter TargetName="arrow" Property="Stroke" Value="{StaticResource BrushBlue}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Custom Geist ComboBox -->
    <Style x:Key="GeistComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource GeistComboBoxItem}" />
        <Setter Property="Background" Value="#141414" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#EDEDED" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="true">
                        <!-- Toggle Button -->
                        <ToggleButton x:Name="toggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      ClickMode="Press"
                                      Focusable="false"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Template="{StaticResource GeistComboBoxToggleButton}" />

                        <!-- Selected Text Presenter -->
                        <ContentPresenter x:Name="contentPresenter"
                                          IsHitTestVisible="false"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />

                        <!-- Dark Popup Menu (NO WHITE DEFAULT WINDOW BACKGROUND) -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="true"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               Margin="0,4,0,0">
                            <Border x:Name="dropDownBorder"
                                    Background="#121212"
                                    BorderBrush="{StaticResource BrushHairlineLight}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Padding="4"
                                    Margin="0,4,0,4">
                                <ScrollViewer x:Name="DropDownScrollViewer"
                                              CanContentScroll="true"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter x:Name="ItemsPresenter"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="false">
                            <Setter TargetName="dropDownBorder" Property="Height" Value="95" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================
         CUSTOM MODERN TOGGLE SWITCH FOR CHECKBOXES
         ============================================== -->
    <Style x:Key="GeistToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#D4D4D4" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center" Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Switch Track & Knob -->
                        <Border x:Name="track"
                                Grid.Column="0"
                                Width="36" Height="20"
                                CornerRadius="10"
                                Background="#262626"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border x:Name="knob"
                                    Width="14" Height="14"
                                    CornerRadius="7"
                                    Background="#8F8F8F"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center" />
                        </Border>

                        <!-- Label Content -->
                        <ContentPresenter Grid.Column="1"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource BrushBlue}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource BrushBlue}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="knob" Property="Background" Value="#FFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="#555555" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
